# Audnexus Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# LEGACY PREFERENCES (from Plex plugin)
# =============================================================================

# Audnexus API region for localized content
# Valid values: au, ca, de, es, fr, in, it, jp, us, uk
# Default: us
REGION=us

# Keep existing genres instead of replacing them
# Default: false
KEEP_EXISTING_GENRES=false

# Store author name as mood tag
# Default: true
STORE_AUTHOR_AS_MOOD=true

# Sort author names by last name
# Default: true
SORT_AUTHOR_BY_LAST_NAME=true

# Simplify book titles (remove subtitles, etc.)
# Default: false
SIMPLIFY_TITLE=false

# Logging level
# Valid values: DEBUG, INFO, WARN, ERROR
# Default: INFO
LOG_LEVEL=INFO

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# HTTP server port
# Default: 8080
PORT=8080

# Cache TTL in seconds (1 week = 604800)
# Default: 604800
CACHE_TTL=604800

# Audnexus API timeout in seconds
# Default: 90
AUDNEXUS_TIMEOUT=90